# Next.js 项目忽略文件配置

# ========== 依赖文件 ==========
/node_modules
/.pnp
.pnp.js
yarn-error.log
pnpm-debug.log*

# ========== 构建输出 ==========
# Next.js 构建目录
/.next
/out
/build

# 生产构建
/dist
/dist-ssr

# ========== 环境变量 ==========
# 环境变量文件（包含敏感信息）
.env
.env.local
.env.development
.env.production
.env.test

# ========== IDE 和编辑器 ==========
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# WebStorm/IntelliJ
.idea
*.iml
*.iws
*.ipr

# Vim
[._]*.s[a-v][a-z]
!*.svg  # 不忽略 SVG 文件
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Emacs
#*.elc
#!.dir-locals.el
**/.emacs.d/**
**/.emacs.desktop
**/*.elc
**/*~
**/#*#
**/[#]*#
**/.emacs.project
**/.emacs.variables

# ========== 操作系统文件 ==========
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ========== 日志文件 ==========
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========== 缓存文件 ==========
# Next.js 缓存
.next/cache

# ESLint 缓存
.eslintcache
.eslintcache_

# Stylelint 缓存
.stylelintcache

# TypeScript 缓存
*.tsbuildinfo

# ========== 测试覆盖率 ==========
# 测试覆盖率报告
/coverage
/coverage/*
/html-report
/html-report/*
/lcov-report
/lcov-report/*
*.lcov
*.info

# ========== 临时文件 ==========
*.tmp
*.temp
*.bak
*.backup
*.cache
*.log

# ========== 部署相关 ==========
# Vercel
.vercel

# Netlify
.netlify

# ========== 其他 ==========
# 可选的 npm 配置文件
.npmrc

# 可选的 yarn 配置文件
.yarnrc

# 项目特定的忽略文件
# 如果有敏感配置文件，请在此添加

# ========== 编译输出 ==========
# 如果有 TypeScript 编译输出
/lib
/es

# 如果有自定义构建脚本输出
/scripts/output

# ========== 文档生成 ==========
# 如果有文档生成工具
/docs/api
/docs/build
